[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1_menu"]

[sub_resource type="StyleBoxFlat" id="StylePanel"]
bg_color = Color(0.055, 0.075, 0.1, 0.96)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.25, 0.65, 0.58, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.03, 0.045, 1)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -260.0
offset_top = -170.0
offset_right = 260.0
offset_bottom = 170.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StylePanel")

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 40

[node name="Content" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="Title" type="Label" parent="Panel/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.95, 0.92, 1)
theme_override_font_sizes/font_size = 38
text = "CARD SHOP SIMULATOR"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Panel/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.7, 0.68, 1)
theme_override_font_sizes/font_size = 16
text = "Build the shop. Read the market. Stay solvent."
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Panel/Margin/Content"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2

[node name="StartButton" type="Button" parent="Panel/Margin/Content"]
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "OPEN SHOP"

[node name="Version" type="Label" parent="Panel/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.38, 0.46, 0.48, 1)
text = "Foundation prototype"
horizontal_alignment = 1

[connection signal="pressed" from="Panel/Margin/Content/StartButton" to="." method="_on_start_button_pressed"]
