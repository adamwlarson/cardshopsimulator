		for _day_index: int in range(7):
			_expect_equal(
				_game_state.call("start_floor"),
				true,
				"7-day seeded run can open floor"
			)
			_expect_equal(
				_game_state.call("start_settle"),
				true,
				"7-day seeded run can settle"
			)
