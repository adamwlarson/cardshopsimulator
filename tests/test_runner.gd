	)
	_expect_equal(
		MarketplaceInspectPolicy.applies_to(snipe),
		false,
		"BC1: BA1 policy does not claim the snipe"
	)
	_expect_equal(
		int(_demand_signals.call("inspect_attention_cost_for", snipe)),
		5,
		"BC1: DemandSignals Inspect cost is 5 without Specialist"
