		"Courier does not skip FLOOR hours"
	)
	_expect_equal(
		_captured_buy_focus_id,
		&"marketplace-outing-steal",
		"Courier opens BuyOpportunityDetail"
	)
	_expect_equal(
		_captured_buy_focus_beat,
		MARKETPLACE_OUTING_BEAT,
