			"func sell_through_mult_for(",
			"shrink"
		)
		and not _function_body_contains(
			demand_src,
			"func sell_through_mult_for(",
			"whale"
		)
		and not _function_body_contains(
			demand_src,
			"func sell_through_mult_for(",
			"walkout"
		)
		and not _function_body_contains(
			demand_src,
			"func sell_through_mult_for(",
			"fire"
		),
		true,
		"AK1: shrink is not folded into sell_listed or sell_through_mult_for"
	)
	queue.free()
	_game_state.call("start_new_game")


