	var hud_scene := FileAccess.get_file_as_string(
		"res://scenes/ui/gameplay_hud.tscn"
	)
	_expect_equal(
		hud_scene.contains("BeatDecision"),
		true,
		"gameplay HUD has the optional beat decision panel"
