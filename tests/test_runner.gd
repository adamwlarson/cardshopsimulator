		_expect_equal(
			outing_dto.unit_cost_cents < midpoint,
			true,
			"outing lot looks underpriced vs noisy comp"
		)
		_expect_equal(
			outing_dto.beat_id,
			MARKETPLACE_OUTING_BEAT,
			"outing opportunity tagged for QA"
