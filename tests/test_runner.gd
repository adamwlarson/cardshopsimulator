		true,
		"AM1: Rep 49 is mid-band baseline"
	)
	_expect_equal(
		CustomerSpawnPolicy.is_mid_band(24),
		false,
		"AM1: Rep 24 is not mid-band"
	)
	_expect_equal(
		CustomerSpawnPolicy.is_mid_band(50),
