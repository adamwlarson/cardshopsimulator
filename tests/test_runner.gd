	var true_band := snipe.lot_condition
	_free_lingering_gameplay_huds()
	var hud := _instantiate_gameplay_hud()
	_expect_equal(hud != null, true, "BC1: HUD loads for auction Inspect")
	if hud != null:
		_select_buy_on_hud(hud, snipe)
