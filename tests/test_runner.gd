	_expect_equal(
		inspect_button.disabled,
		true,
		"Inspect★ disables after a successful inspect"
	)

	_game_state.set("attention_remaining", 4)
	Callable(hud, "_update_attention").call(4)
	var shady := _demand_signals.call(
		"buy_signal",
