func _test_bt1_confirm_no_truth() -> void:
	_bt1_reset_at(8, 40)
	var dto: BuyConfirmSignal = _demand_signals.call(
		"buy_signal_for_id",
		DistributorMenuPolicy.offer_id(8, &"AA-DUST-ETB")
