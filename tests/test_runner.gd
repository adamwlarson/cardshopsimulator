		int(_economy.get("balance_cents")),
		cash_before,
		"AN1: accept leaves cash unchanged"
	)
	_expect_equal(
		_an1_ledger_size(),
		ledger_before,
		"AN1: accept writes no cash ledger"
	)
	_expect_equal(
		_demand_signals.call("open_player_trade") == null,
		true,
		"AN1: accepted offer is gone"
	)


