func _test_hire_cashier_beat() -> void:
	_game_state.call("set_balance_config", NORMAL_CONFIG)
	_game_state.call("start_new_game")
	_game_state.set("current_day", 5)
	_game_state.set("current_phase", DayPhasePolicy.PREP)
