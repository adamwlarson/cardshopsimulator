		_demand_signals.call("open_auction_snipe") == null,
		true,
		"AS1: declined offer is gone for the day"
	)
	_expect_equal(
		int(_game_state.get("current_reputation")),
		rep_before,
		"AS1: decline leaves Rep unchanged"
	)
	_as1_expect_nothing_moved(before, "AS1 decline")


