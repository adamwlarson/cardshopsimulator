; Engine configuration file.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="Card Shop Simulator"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
GameState="*res://scripts/autoload/game_state.gd"
Economy="*res://scripts/autoload/economy.gd"
InventoryService="*res://scripts/autoload/inventory_service.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.06, 1)
